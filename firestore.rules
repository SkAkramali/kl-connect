// Firestore security rules for this app.
//
// NOTE: This file is committed for reference/viewing only — it is not covered
// by the tutorial. The live rules are managed and deployed in the Firebase
// console. Keep this file in sync with the console if you change them there.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isMember(roomId) { return exists(/databases/$(database)/documents/memberships/$(roomId + "_" + request.auth.uid)); }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /rooms/{roomId} {
      // Existing join-code flow needs room metadata readable to signed-in users.
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && (get(/databases/$(database)/documents/rooms/$(roomId)).data.isPrivate == false || isMember(roomId)));
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && (get(/databases/$(database)/documents/rooms/$(roomId)).data.isPrivate == false || isMember(roomId));
        allow update, delete: if false;
      }
    }
    match /memberships/{membershipId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == resource.data.uid);
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      allow update: if false;
    }
    match /moderationLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
  }
}
